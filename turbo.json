{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["HOTEL_API_URL"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "test": {
      "passThroughEnv": ["DATABASE_URL", "HOTEL_TEST_DB_PREFIX", "GITHUB_ACTIONS"]
    },
    "typecheck": {}
  }
}
