# Portovi hotelskog sistema na NAS-u 192.168.1.199 (opseg 4200-4299 + infrastruktura). Vidi CLAUDE.md.
# Baze i Redis su vezani na 127.0.0.1 NAS-a: URL-ovi ispod važe na NAS-u ili kroz SSH tunel.
# Na NAS-u se pravi env fajl sa nasumičnim lozinkama; ovde su samo vrednosti za razvoj.
HOTEL_API_PORT=4200
HOTEL_WEB_PORT=4201
HOTEL_HUB_API_PORT=4210
HOTEL_HUB_WEB_PORT=4211
HOTEL_DEVICE_AGENT_PORT=4220
HOTEL_ADMINER_PORT=4280

# hotel-web prosleđuje /api/* na hotel-api (rewrite se upisuje pri `next build`).
# Staging slika na NAS-u se gradi sa HOTEL_API_URL=http://hotel-api-claude:4200 (deploy.sh).
HOTEL_API_URL=http://localhost:4200
# Staging na NAS-u (infrastructure/nas/deploy.sh): API http://192.168.1.199:4200,
# recepcija http://192.168.1.199:4201 (kontejner hotel-web-claude sluša na 3000).
# Tamo DATABASE_URL, HOTEL_SECRET_KEY i HOTEL_ROOT_KEYSET dolaze iz /volume1/ci/hotel/hotel.env.

# CSRF (apps/hotel-api/src/http.ts): origin-i kojima je dozvoljen POST/PUT/PATCH/DELETE, lista sa zarezima,
# npr. https://recepcija.hotel.rs. Prazno: Origin mora biti host kome je zahtev poslat (kroz Next rewrite
# X-Forwarded-Host, tj. adresa recepcije). Klijenti bez Origin i Sec-Fetch-Site (skripte) uvek prolaze.
HOTEL_WEB_ORIGIN=

# Objava manifesta (scripts/publish-manifest.mjs): servisni token product_publisher iz Admin Panela.
# Ne čuva se u repou; zadaje se samo u okruženju pri objavi.
HOTEL_PUBLISHER_TOKEN=

HOTEL_POSTGRES_PORT=5442
HOTEL_HUB_POSTGRES_PORT=5443
HOTEL_REDIS_PORT=6390

# Baza instalacije (samo za lokalni razvoj)
HOTEL_POSTGRES_DB=hotel
HOTEL_POSTGRES_USER=hotel
HOTEL_POSTGRES_PASSWORD=hotel_dev

# Baza huba, odvojena od baze instalacije
HOTEL_HUB_POSTGRES_DB=hotel_hub
HOTEL_HUB_POSTGRES_USER=hotel_hub
HOTEL_HUB_POSTGRES_PASSWORD=hotel_hub_dev

DATABASE_URL=postgres://hotel:hotel_dev@localhost:5442/hotel
HUB_DATABASE_URL=postgres://hotel_hub:hotel_hub_dev@localhost:5443/hotel_hub
REDIS_URL=redis://localhost:6390
REDIS_KEY_PREFIX=hotel:

# Licenciranje prema Centralnom admin panelu. Bez korena ili tajnog ključa API radi,
# ali aktivacija vraća 503 licensing_not_configured.
# Plain http je dozvoljen samo uz CENTRAL_ADMIN_ALLOW_HTTP=true (staging na LAN-u).
CENTRAL_ADMIN_URL=http://192.168.1.199:4100
CENTRAL_ADMIN_ALLOW_HTTP=true
# Izlaz GET {CENTRAL_ADMIN_URL}/v1/keys (JSON ili base64 tog JSON-a), zakucan pri instalaciji.
HOTEL_ROOT_KEYSET=
# 32 nasumična bajta, base64url (npr. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))").
# Šifruje privatni ključ instalacije u bazi; ne menja se posle aktivacije.
HOTEL_SECRET_KEY=
